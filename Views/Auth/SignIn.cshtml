@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}

<div class="ex-auth">
    <div class="ex-auth-form">
        <div class="ex-auth-form-inner">
            <a href="/" class="ex-brand mb-10 px-0" style="border:0;height:auto;">
                <span class="ex-brand-mark"></span>
                <span class="ex-brand-text">
                    <span class="ex-brand-name">EXODUS</span>
                    <span class="ex-brand-sub">System Manual</span>
                </span>
            </a>

            <form class="form w-100" id="loginForm" novalidate>
                <div class="mb-9">
                    <h1 class="ex-page-title mb-2">로그인</h1>
                    <p class="ex-page-desc mb-0">사내 계정으로 시스템 매뉴얼 플랫폼에 접속합니다.</p>
                </div>

                <div id="loginError" class="alert alert-danger d-none py-3" role="alert"></div>

                <input type="hidden" id="returnUrl" value="@returnUrl" />

                <div class="fv-row mb-6">
                    <label class="form-label" for="userId">ID</label>
                    <input type="text" class="form-control form-control-lg form-control-solid"
                           id="userId" name="USER_ID" autocomplete="username" autofocus />
                </div>

                <div class="fv-row mb-8">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" class="form-control form-control-lg form-control-solid"
                           id="password" name="PASSWORD" autocomplete="current-password" />
                </div>

                <button type="submit" id="loginBtn" class="btn btn-lg btn-primary w-100">
                    <span class="indicator-label">Sign In</span>
                    <span class="indicator-progress">
                        Please wait...
                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </form>

            <div class="ex-auth-copy">
                &copy; @DateTime.Now.Year Exodus Advanced Communications. All rights reserved.
            </div>
        </div>
    </div>

    <div class="ex-auth-aside">
        <div class="ex-auth-aside-inner">
            <span class="ex-auth-eyebrow">Knowledge Base Platform</span>
            <h2 class="ex-auth-headline">시스템 매뉴얼을<br />한곳에서 작성하고 배포합니다.</h2>
            <p class="ex-auth-sub">
                목차별 담당 팀이 함께 문서를 채우고, 검토를 거쳐 표준 서식의 PDF 로 배포합니다.
            </p>
            <ul class="ex-auth-points">
                <li>팀 단위 공동 작성과 편집 권한 관리</li>
                <li>목차 템플릿으로 문서 구조 표준화</li>
                <li>변경 이력 추적과 버전 관리</li>
            </ul>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/custom/auth/signIn.js" asp-append-version="true"></script>
}
