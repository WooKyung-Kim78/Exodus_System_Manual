@{
    ViewData["Title"] = "공통 코드";
}

<div class="container-fluid" id="app" v-cloak>
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <h1 class="h4 mb-1">공통 코드</h1>
            <div class="text-muted fs-7">미리보기 표지 문구와 로고를 여기서 바꿉니다.</div>
        </div>
        <button class="btn btn-primary" @@click="openForm(null)">+ 코드 추가</button>
    </div>

    <div class="row g-5">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header align-items-center">
                    <h3 class="card-title">표지 로고</h3>
                </div>
                <div class="card-body">
                    <div class="border rounded p-5 text-center mb-4" style="background:#f9f9fb">
                        <img v-if="logoPath" :src="logoPath" style="max-width:100%;max-height:80px" />
                        <span v-else class="text-muted fs-8">등록된 로고가 없습니다.</span>
                    </div>
                    <button class="btn btn-light-primary w-100" :disabled="uploading" @@click="pickLogo">
                        {{ uploading ? '업로드 중...' : '로고 이미지 업로드' }}
                    </button>
                    <div class="form-text mt-2">png · jpg · gif · webp. 가로가 긴 이미지가 표지에 잘 맞습니다.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-header align-items-center">
                    <h3 class="card-title">코드 목록</h3>
                    <div class="card-toolbar">
                        <select class="form-select form-select-sm w-200px" v-model="filter" @@change="callList">
                            <option value="">전체 분류</option>
                            <option v-for="c in categories" :key="c" :value="c">{{ c }}</option>
                        </select>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div v-if="loading" class="text-center text-muted py-15">불러오는 중...</div>
                    <div v-else-if="!list.length" class="text-center text-muted py-15">코드가 없습니다.</div>
                    <table v-else class="table table-row-bordered align-middle mb-0">
                        <thead class="fw-bold fs-8 text-muted bg-light">
                            <tr>
                                <th class="ps-5" style="width:130px">분류</th>
                                <th style="width:150px">코드</th>
                                <th>값</th>
                                <th class="text-end pe-5" style="width:130px">관리</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="c in list" :key="c.IDX">
                                <td class="ps-5 text-muted fs-8">{{ c.CATEGORY }}</td>
                                <td class="fs-8">{{ c.CODE }}</td>
                                <td>
                                    <span v-if="c.NAME" class="text-gray-800">{{ c.NAME }}</span>
                                    <span v-else class="text-muted fs-8">(비어 있음)</span>
                                </td>
                                <td class="text-end pe-5">
                                    <button class="btn btn-sm btn-light py-1 px-2" @@click="openForm(c)">수정</button>
                                    <button class="btn btn-sm btn-light-danger py-1 px-2"
                                            :disabled="c.CATEGORY === 'COVER'" @@click="remove(c)">삭제</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="codeModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ form.IDX ? '코드 수정' : '코드 추가' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div v-if="formError" class="alert alert-danger py-3">{{ formError }}</div>

                    <div class="row g-4 mb-4">
                        <div class="col-6">
                            <label class="form-label required">분류</label>
                            <input type="text" class="form-control" v-model.trim="form.CATEGORY"
                                   :disabled="!!form.IDX" maxlength="50" placeholder="COVER" />
                        </div>
                        <div class="col-6">
                            <label class="form-label required">코드</label>
                            <input type="text" class="form-control" v-model.trim="form.CODE"
                                   :disabled="!!form.IDX" maxlength="50" placeholder="TITLE_LINE1" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">값</label>
                        <input type="text" class="form-control" v-model="form.NAME" maxlength="200" />
                    </div>
                    <div>
                        <label class="form-label">정렬 순서</label>
                        <input type="number" class="form-control" v-model.number="form.ORDER_NUM" min="0" max="999" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">취소</button>
                    <button type="button" class="btn btn-primary" :disabled="saving" @@click="save">저장</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/custom/admin/code.js" asp-append-version="true"></script>
}
