@{
    ViewData["Title"] = "Manuals";
}

<div class="container-fluid" id="app" v-cloak>
    <div class="card">
        <div class="card-header align-items-center">
            <h3 class="card-title">System Manual List</h3>
            <div class="card-toolbar gap-3">
                <select class="form-select form-select-sm w-150px" v-model="filter.status" @@change="callList">
                    <option value="">전체 상태</option>
                    <option value="DRAFT">작성중</option>
                    <option value="REVIEW">결재요청</option>
                    <option value="APPROVED">결재완료</option>
                    <option value="PUBLISHED">발행</option>
                    <option value="OBSOLETE">폐기</option>
                </select>
                <label class="form-check form-check-sm form-check-custom">
                    <input class="form-check-input" type="checkbox" v-model="filter.onlyMine" @@change="callList" />
                    <span class="form-check-label">내 문서만</span>
                </label>
                <button class="btn btn-sm btn-primary" @@click="openNew">New Manual</button>
            </div>
        </div>

        <div class="card-body">
            <div v-if="loading" class="text-center text-muted py-10">불러오는 중...</div>
            <div v-else-if="!list.length" class="text-center text-muted py-10">문서가 없습니다.</div>
            <table v-else class="table table-row-bordered align-middle gy-3">
                <thead>
                    <tr class="fw-bold fs-7 text-gray-700 text-uppercase">
                        <th>Doc No.</th>
                        <th>Model Name</th>
                        <th>Job Number</th>
                        <th class="w-110px">Status</th>
                        <th>Option</th>
                        <th class="w-120px">Requester</th>
                        <th class="w-110px">등록일</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="item in list" :key="item.M_ID" class="cursor-pointer" @@click="goDetail(item.M_ID)">
                        <td class="text-gray-600">{{ item.DOC_NUM }}</td>
                        <td>
                            <span class="fw-bold text-gray-800">{{ item.MODEL_NAME }}</span>
                            <span v-if="item.MY_ROLE" class="badge badge-light-info ms-2">{{ item.MY_ROLE }}</span>
                        </td>
                        <td class="text-gray-600">{{ item.JOB_NUMBER }}</td>
                        <td><span :class="statusClass(item.STATUS)">{{ statusLabel(item.STATUS) }}</span></td>
                        <td class="text-gray-600 text-truncate" style="max-width:260px" :title="item.OPTION_TEXT">
                            {{ item.OPTION_TEXT }}
                        </td>
                        <td class="text-gray-600">{{ item.REQUESTER_NAME }}</td>
                        <td class="text-gray-600">{{ formatDate(item.REG_DT) }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="newManualModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New System Manual</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div v-if="formError" class="alert alert-danger py-3">{{ formError }}</div>

                    <div class="mb-4">
                        <label class="form-label required">Model Name</label>
                        <input type="text" class="form-control" v-model.trim="form.MODEL_NAME" maxlength="100" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Job Number</label>
                        <datasheet-select v-model="form.JOB_NUMBER" @@select="pickDatasheet"></datasheet-select>
                        <div class="form-text">Datasheet 를 고르면 SPECIFICATIONS 목차에 사양이 자동으로 보입니다.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Label</label>
                        <select class="form-select" v-model="form.LABEL">
                            <option value="">선택 안 함</option>
                            <option value="EXODUS">Exodus</option>
                            <option value="OEM">OEM</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Cooling</label>
                        <select class="form-select" v-model="form.COOLING">
                            <option value="">선택 안 함</option>
                            <option value="AIR">Air</option>
                            <option value="LIQUID">Liquid</option>
                        </select>
                        <div class="form-text">Label·Cooling 에 맞는 필수 목차가 자동으로 들어갑니다.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Option</label>
                        <textarea class="form-control" rows="2" v-model.trim="form.OPTION_TEXT" maxlength="500"></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Version</label>
                        <input type="text" class="form-control" v-model.trim="form.DOC_VERSION" maxlength="20" placeholder="1.0" />
                        <div class="form-text">PDF 아래쪽에 "1 | Page - Ver. 1.0" 형식으로 찍힙니다.</div>
                    </div>
                    <div>
                        <label class="form-label">Page Size</label>
                        <select class="form-select" v-model="form.PAGE_SIZE">
                            <option value="LETTER">Letter (216 x 279mm)</option>
                            <option value="A4">A4 (210 x 297mm)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">취소</button>
                    <button type="button" class="btn btn-primary" :disabled="saving" @@click="submitNew">
                        {{ saving ? '생성 중...' : '생성' }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/custom/manual/datasheet-select.js" asp-append-version="true"></script>
    <script src="~/js/custom/manual/index.js" asp-append-version="true"></script>
}
