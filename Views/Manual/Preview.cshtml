@model ExodusSystemManual.Models.PreviewViewModel
@{
    ViewData["Title"] = "Preview";
    var h = Model.Header;
}

@section css {
    <link href="~/css/preview.css" rel="stylesheet" asp-append-version="true" />
}

<div class="preview-toolbar">
    <a class="btn btn-sm btn-light" href="/editor?mid=@h.M_ID">← 편집기</a>
    <a class="btn btn-sm btn-light" href="/manual/detail?mid=@h.M_ID">문서 정보</a>
    <div class="btn-group ms-3" role="group">
        <button type="button" class="btn btn-sm btn-secondary" id="btnFlow">연속 보기</button>
        <button type="button" class="btn btn-sm btn-light" id="btnPages">페이지 보기</button>
    </div>
    <div class="ms-auto d-flex align-items-center gap-2">
        <span id="pdfState" class="text-muted fs-8"></span>
        <button class="btn btn-sm btn-light-primary" onclick="window.print()">인쇄</button>
        <button class="btn btn-sm btn-primary" id="btnPdf" data-mid="@h.M_ID">PDF 다운로드</button>
    </div>
</div>

<partial name="_DocSheet" model="Model" />
<iframe id="pdfFrame" class="preview-pages d-none" title="페이지 보기"></iframe>
<div id="pdfLoading" class="preview-loading d-none">
    <div class="spinner-border text-primary" role="status"></div>
    <div class="mt-4 text-gray-600">페이지를 만드는 중입니다...</div>
</div>

@section scripts {
    <script src="~/js/custom/manual/preview.js" asp-append-version="true"></script>
}
