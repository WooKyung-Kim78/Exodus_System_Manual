@using Microsoft.AspNetCore.Http
@{
    var userName = Context.Session.GetString("FULL_NAME");
    var userId = Context.Session.GetString("USER_ID");
    var team = Context.Session.GetString("USER_TEAM");
    var division = Context.Session.GetString("USER_DIVISION");
    var role = Context.Session.GetString("ROLE");
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] - EXODUS System Manual</title>
    <link rel="shortcut icon" href="~/assets/media/logos/favicon.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
    <link href="~/assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/custom.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/custom/jquery-toast/jquery.toast.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/app.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("css", required: false)
</head>
<body id="kt_body" class="header-fixed header-tablet-and-mobile-fixed">
    <div class="d-flex flex-column flex-root">
        <div class="page d-flex flex-row flex-column-fluid">
            <div class="wrapper d-flex flex-column flex-row-fluid">

                <div id="kt_header" class="header align-items-stretch">
                    <div class="container-fluid d-flex align-items-stretch justify-content-between">
                        <div class="d-flex align-items-center flex-grow-1">
                            <a href="/" class="d-flex align-items-center me-10">
                                <span class="fs-3 fw-bolder text-dark">EXODUS</span>
                                <span class="fs-6 fw-normal text-gray-600 ms-2">System Manual</span>
                            </a>

                            <div class="menu menu-lg-rounded menu-column menu-lg-row menu-state-bg menu-title-gray-700 menu-state-title-primary menu-state-icon-primary menu-state-bullet-primary menu-arrow-gray-400 fw-bold my-5 my-lg-0 align-items-stretch"
                                 id="kt_header_menu" data-kt-menu="true">
                                <div class="menu-item me-lg-1">
                                    <a class="menu-link py-3 @(path == "/" ? "active" : "")" href="/">
                                        <span class="menu-title">Dashboard</span>
                                    </a>
                                </div>
                                <div class="menu-item me-lg-1">
                                    <a class="menu-link py-3 @(path.StartsWith("/manual") ? "active" : "")" href="/manual">
                                        <span class="menu-title">Manuals</span>
                                    </a>
                                </div>
                                @if (role == "ADMIN" || role == "SUPPORTER")
                                {
                                    <div class="menu-item menu-lg-down-accordion me-lg-1"
                                         data-kt-menu-trigger="click" data-kt-menu-placement="bottom-start">
                                        <span class="menu-link py-3 @(path.StartsWith("/admin") ? "active" : "")">
                                            <span class="menu-title">Admin</span>
                                            <span class="menu-arrow d-lg-none"></span>
                                        </span>
                                        <div class="menu-sub menu-sub-lg-down-accordion menu-sub-lg-dropdown px-lg-2 py-lg-4 w-lg-200px">
                                            <div class="menu-item">
                                                <a class="menu-link @(path.StartsWith("/admin/setting") ? "active" : "")" href="/admin/setting">
                                                    <span class="menu-title">Settings</span>
                                                </a>
                                            </div>
                                            <div class="menu-item">
                                                <a class="menu-link @(path.StartsWith("/admin/code") ? "active" : "")" href="/admin/code">
                                                    <span class="menu-title">Common Codes</span>
                                                </a>
                                            </div>
                                            @if (role == "ADMIN")
                                            {
                                                <div class="menu-item">
                                                    <a class="menu-link @(path.StartsWith("/admin/section-template") ? "active" : "")" href="/admin/section-template">
                                                        <span class="menu-title">Section Templates</span>
                                                    </a>
                                                </div>
                                                <div class="menu-item">
                                                    <a class="menu-link @(path.StartsWith("/admin/user-role") ? "active" : "")" href="/admin/user-role">
                                                        <span class="menu-title">User Roles</span>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center ms-1 ms-lg-3">
                            <div class="cursor-pointer symbol symbol-35px symbol-md-40px"
                                 data-kt-menu-trigger="click" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                                <img src="~/assets/media/avatars/user.png" alt="user" />
                            </div>
                            <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-primary fw-bold py-4 fs-6 w-275px" data-kt-menu="true">
                                <div class="menu-item px-3">
                                    <div class="menu-content d-flex align-items-center px-3">
                                        <div class="symbol symbol-50px me-5">
                                            <img alt="user" src="~/assets/media/avatars/user.png" />
                                        </div>
                                        <div class="d-flex flex-column">
                                            <div class="fw-bolder fs-5">@userName</div>
                                            <div class="text-muted fs-7">@userId</div>
                                            <div class="text-muted fs-7">@division @team</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="separator my-2"></div>
                                <div class="menu-item px-5">
                                    <a href="/auth/logout" class="menu-link px-5">Sign out</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="content d-flex flex-column flex-column-fluid pt-8">
                    @RenderBody()
                </div>

                <div class="footer py-4">
                    <div class="container-fluid d-flex flex-column flex-md-row align-items-center justify-content-between">
                        <div class="text-dark">
                            <span class="text-muted fw-bold me-1">&copy; @DateTime.Now.Year</span>
                            <span class="text-gray-800">Exodus Advanced Communications</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "__AjaxAntiForgeryForm" })) { @Html.AntiForgeryToken() }

    <script>var hostUrl = "/assets/";</script>
    <script src="~/assets/js/common/vue.2.7.14.min.js"></script>
    <script src="~/assets/plugins/global/plugins.bundle.js"></script>
    <script src="~/assets/js/scripts.bundle.js"></script>
    <script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/assets/plugins/custom/jquery-toast/jquery.toast.min.js"></script>
    <script src="~/assets/js/common/constants.js"></script>
    <script src="~/assets/js/common/jsUtils.js"></script>
    <script src="~/js/common/ajaxSetting.js" asp-append-version="true"></script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
