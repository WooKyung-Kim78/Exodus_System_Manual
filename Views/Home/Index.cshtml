@{
    ViewData["Title"] = "Dashboard";
    var userName = Context.Session.GetString("FULL_NAME");
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-6">
        <h1 class="h3 mb-0">Dashboard</h1>
        <a class="btn btn-primary" href="/manual">Manuals</a>
    </div>

    <div class="alert alert-primary d-flex flex-column p-5 mb-6">
        <span class="fw-bold">@userName 님, 반갑습니다.</span>
        <span class="text-muted">Phase 1(기반·인증)까지 완료되었습니다. 매뉴얼 생성과 캔버스 편집기는 다음 단계에서 연결됩니다.</span>
    </div>

    <div class="row g-5">
        @foreach (var card in new[] { ("작성중", "-"), ("결재 대기", "-"), ("발행 완료", "-"), ("미해결 코멘트", "-") })
        {
            <div class="col-6 col-lg-3">
                <div class="card card-flush h-100">
                    <div class="card-body">
                        <div class="text-gray-500 fw-semibold">@card.Item1</div>
                        <div class="fs-2hx fw-bold text-gray-800">@card.Item2</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
